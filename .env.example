# Enterprise Multi-Agent Coding System -- environment reference
# Copy to `.env` and adjust. Every value is optional.

# OpenRouter API key. When EMPTY the system runs in DEMO_MODE (offline,
# deterministic canned LLM responses).
OPENROUTER_API_KEY=

# Legacy static routing overrides (role -> model slug). Inert while
# FREE_MODEL_ROUTING=true -- the free router picks models by capability,
# health and quota. Uncomment with FREE_MODEL_ROUTING=false to use static
# routing; free-model values are pre-filled as an example.
# MODEL_OVERRIDES={"builder_initial": "qwen/qwen3.8-27b:free", "builder_patch": "qwen/qwen3.8-27b:free", "builder_escalate": "dots-studio/dots-3-note-preview:free", "reviewer_feature": "nvidia/nemotron-3-super-120b-a12b:free", "reviewer_bugfix": "nvidia/nemotron-3-super-120b-a12b:free"}

# Cross-project IntegrationAgent (true/false)
ENABLE_INTEGRATION_AGENT=true

# Provider-specific prompt caching for static prompt parts (true/false)
CACHE_ENABLED=true

# DEMO_MODE: auto (default: on when no API key), or force true/false
DEMO_MODE=auto

# Structured logger minimum level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Echo compact colored event lines to the console in addition to the JSONL
# log file (true/false; default true -- set false for silent console)
CONSOLE_ECHO=true

# Real execution: apply Builder diffs to project files and gate approval on
# REAL pytest runs (live mode only; always simulated in DEMO_MODE)
REAL_EXECUTION=true

# Budget (seconds) for the --once single-pass window (default 600)
ONCE_BUDGET_S=600
# Grace period (seconds) for every project loop to report its first scheduling
# decision before a --once pass proceeds anyway. A pass waits for the loops to
# *settle*, not for the boards to look empty: a goal-only project has an empty
# board until the Spec Author writes one, and treating that as "finished" made
# --once return in seconds having authored nothing. Raise this only if a
# project loop is genuinely slow to start; on expiry the pass logs
# once_boot_timeout and continues with the loops that did answer.
ONCE_BOOT_S=120

# Wall-clock budget (seconds) per LLM candidate call; empty replies walk
# the fallback chain (default 360)
LLM_CALL_TIMEOUT_S=360

# Bounded auto-requeue for failed tasks: requeue once after this many
# seconds of cooldown (FAILED_AUTO_REQUEUES=0 disables)
FAILED_RETRY_COOLDOWN_S=600
FAILED_AUTO_REQUEUES=1

# Environment self-heal: on missing imports run pip install -r
# <project>/requirements.txt once per task, then re-run the gate
ENV_AUTOHEAL_ENABLED=true
PIP_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# v2.6 free multi-provider routing (capacity layer)
# ---------------------------------------------------------------------------
# Route every LLM call through the ranked free-provider capacity layer.
# false restores the legacy static OpenRouter MODEL_ROUTING path exactly.
FREE_MODEL_ROUTING=true
# When every free candidate is unhealthy/exhausted, fall back to the static
# (usually paid) tables instead of deferring. Off = fail closed, no spend.
FREE_MODELS_ALLOW_PAID_FALLBACK=false
# Ranked candidates one call may try.
MODEL_ROUTER_TOP_K=5
# Output-token floor for roles that emit WHOLE FILES inside a structured
# envelope. `spec_author` writes each task's complete test inline, so its budget
# scales with plan size, not reply shape -- and an 8k-token model cannot fit
# three small test files however healthy it looks. Observed: the top-ranked
# author answered with a single planner-shaped object because it had no room.
MODEL_FILE_BEARING_MIN_MAX_OUTPUT=32768
# How long a model stays out of EVERY rotation after a provider reports it
# unavailable / not found / deprecated. This is availability, not quality, and
# it is kept out of the health registry on purpose: that registry is keyed per
# role and needs 20 aggregated calls before it acts, so a model that 404s for
# every role kept winning on its historical average (observed: ranked first
# for four roles, then 404 on all of them). Repeated confirmations multiply the
# cooldown, capped at 4x; it expires on its own, and `--models probe` is how
# you re-admit a model early.
MODEL_UNAVAILABLE_COOLDOWN_S=900
# Hybrid reliability: canary probes on `--models probe` + observed outcomes.
MODEL_PROBE_ENABLED=true
MODEL_PROBE_MAX_MODELS=6
MODEL_REGISTRY_TTL_H=24
MODEL_ALLOW_PREVIEW=true
# Fraction of each provider quota held back for probes/in-call retries.
QUOTA_RESERVE_PCT=0.10
# Optional per-role daily call caps as JSON, e.g. {"builder": 200}
QUOTA_ROLE_CAPS=
# Exact-match response cache (dedupes byte-identical LLM calls).
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_H=24
LLM_CACHE_MAX_ENTRIES=500
# Quota exhaustion defers a task to the earliest provider reset.
LLM_DEFER_MAX_S=3600

# Extra free providers (all OpenAI-compatible; see providers.py for limits):
#   GROQ_API_KEY, GEMINI_API_KEY, ZAI_API_KEY, NVIDIA_API_KEY, COHERE_API_KEY
# Cloudflare Workers AI needs both:
#   CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID
# Disabled by default (key alone does NOT activate them):
#   MISTRAL_API_KEY       -- requires a paid Mistral plan
#   DASHSCOPE_API_KEY     -- Alibaba Model Studio needs region/account info
#   CEREBRAS_API_KEY      -- card-required trial
#   local server          -- LOCAL_LLM_ENABLED=true + LOCAL_LLM_BASE_URL
# Opt in explicitly with PROVIDERS_ENABLED=mistral,alibaba,cerebras,local.
# Per-provider quota overrides: GROQ_RPD, GEMINI_RPM, OPENROUTER_BASE_URL, ...
# One-time $10 OpenRouter credit raises the free daily quota 50 -> 1000.

# ---------------------------------------------------------------------------
# v2.6 objective gate + divergence (code tasks and ML experiments)
# ---------------------------------------------------------------------------
# Objective-gate subprocess timeout for experiment/benchmark commands.
OBJECTIVE_TIMEOUT_S=1800
# Divergence: off unless a task sets divergent:true or a project ships
# .agent/divergence.json {"enabled": true, "n_candidates": 3}
DIVERGENCE_ENABLED=false
DIVERGENCE_DEFAULT_CANDIDATES=3
DIVERGENCE_MAX_CANDIDATES=4
DIVERGENCE_TIE_EPSILON=0.02
DIVERGENCE_JUDGE_ENABLED=true
DIVERGENCE_MERGE_ENABLED=false
# Plan-level divergence: correctness/performance/simplicity lenses merged.
PLAN_DIVERGENCE=false

# ---------------------------------------------------------------------------
# v2.6 Kaggle domain pack (inert unless .agent/domain.json opts in)
# ---------------------------------------------------------------------------
KAGGLE_AUTO_SUBMIT=false
KAGGLE_DAILY_SUBMISSION_CAP=5
KAGGLE_MIN_CV_IMPROVEMENT=0.0
KAGGLE_SUBMIT_WAIT_S=600
# Campaign director: propose queued experiments when the board starves.
CAMPAIGN_AUTO_GENERATE=false
CAMPAIGN_DIRECTOR_ENABLED=false
CAMPAIGN_MAX_NEW_TASKS=3

# ---------------------------------------------------------------------------
# Secrets and egress
# ---------------------------------------------------------------------------
# Replace only the VALUES of credential-shaped variables (names containing
# KEY / SECRET / TOKEN / PASSWORD / CREDENTIAL), in `.env` or
# `projects/<name>/.env`.  Never in `.env.example`, a task objective or a
# context.md rule -- those are read into model prompts.
# Verify before your first commit:  python main.py --preflight scan
REDACTION_ENABLED=true
SECRET_SCAN_ENABLED=true
# Minimum length for an env value to count as a redactable secret.
SECRET_SCAN_MIN_LEN=8
# JSON files `--preflight scrub` inspects (dry run unless --apply).
SECRET_SCRUB_TARGETS=.shared_workspace/anti_patterns.json,.shared_workspace/pattern_memory.json
# Allow an LLM-authored experiment command to be an arbitrary shell string.
# Leave false. Two independent reasons:
#   1. the Kaggle pack only accepts a plain python/py invocation, so a chained
#      command (`env > reports/metrics.json`) exits 0, leaves a parseable
#      metrics file, PASSES the objective gate, and is then submitted to Kaggle
#      with every credential in the environment;
#   2. since v2.8 the generic objective runner parses run_command to an argv and
#      executes it with shell=False, refusing anything with a shell
#      metacharacter -- so this escape hatch is the only way back to a shell.
KAGGLE_ALLOW_ARBITRARY_RUN_COMMAND=false

# ---------------------------------------------------------------------------
# Circuit breaker (v2.9) -- replaces the deleted Council's one useful reflex
# ---------------------------------------------------------------------------
# The Council was removed in v2.9: over a full six-module build it produced 47
# arbiter failures, 9 decisions held for a human, and not one intervention that
# actually fixed anything, at the price of the most expensive prompt in the
# system. Stopping a doomed run does not need a model, so this does it with
# arithmetic: zero completions plus too many tokens spent means the project is
# not learning, it is looping.
BREAKER_ENABLED=true
# Tokens a project may spend in the window with 0 tasks done before the breaker
# pauses it. The reference build spent 766k tokens for 6 delivered modules, so a
# healthy project clears this; a wedged one trips it early. 0 disables.
BREAKER_TOKENS_PER_WINDOW=250000

# ---------------------------------------------------------------------------
# Spec Critic (v2.9): verify the spec before building, not after failing
# ---------------------------------------------------------------------------
# The reference build put all 12 escalations at the human handover boundary and
# none at an engineering defect -- six were contradictions between an objective
# and a test file that were each individually reasonable. This moves that check
# to where it is free.
#
# The deterministic tier costs nothing (no model call) and catches what a
# machine can decide: a test importing a name nothing defines, a declared
# `-> dict` return the test indexes as `[0]`, a task promising unresolvable
# tests. Leave it on.
SPEC_CRITIC_ENABLED=true
# The model pass, one call per task, with the full objective and full test
# source. This is the part to disable under quota pressure -- and the part that
# can only ADD findings, never clear a deterministic one.
SPEC_CRITIC_LLM_ENABLED=true
SPEC_CRITIC_MAX_SOURCE_CHARS=24000

# ---------------------------------------------------------------------------
# Spec Author (v2.9): the system writes its own specification
# ---------------------------------------------------------------------------
# --new-project NAME --goal "one paragraph" authors a tests-first board on the
# first orchestration run. Authored tests are written to disk BEFORE the tasks
# are baselined, which is what freezes them: TestIntegrityGuard then refuses the
# Builder any edit to the contract it is graded against.
#
# Start with this false and read the plan with --author-plan, then turn it on.
SPEC_AUTHOR_ENABLED=true
SPEC_AUTHOR_MAX_TASKS=8
SPEC_AUTHOR_WRITE_TESTS=false
# Bounded authoring attempts per goal, with the previous attempt's rejection
# notes fed back so a retry cannot replay the same cached reply. On exhaustion
# the state lands in projects/<name>/.agent/spec_author_state.json with
# gave_up=true and a remedy; delete that file to let it try again. Without a
# budget an unsatisfiable goal burns the whole --once window re-reading one
# failure (observed: 10 minutes, one cached answer).
SPEC_AUTHOR_MAX_ATTEMPTS=3
# Linear backoff between authoring attempts, capped at 60s.
SPEC_AUTHOR_RETRY_BACKOFF_S=15

# ---------------------------------------------------------------------------
# Escalation diagnosis (v2.9)
# ---------------------------------------------------------------------------
# One call per escalation, on evidence the loop already recorded. Produces a
# cause from a closed vocabulary (so the steering monitor can cluster repeats)
# and a remedy. Only narrow_objective and split_task can touch the board, only
# within validation.BOARD_WRITE_ALLOWLIST, and only above the confidence gate --
# the diagnosing model also participated in the work that failed.
DIAGNOSIS_ENABLED=true
DIAGNOSIS_MIN_CONFIDENCE=0.6

# ---------------------------------------------------------------------------
# Unbroken lines (v2.9)
# ---------------------------------------------------------------------------
# Carry a bounded summary of completed tasks into the next task's prompt, so a
# line does not re-derive the API decisions an earlier task already settled.
LINE_CONTINUITY=true
LINE_NOTE_LIMIT=6
# Independent lines per project. The partition is computed, validated and shown
# in the manifest at any value; the scheduler is still sequential, so 1 is the
# honest setting until you have watched a few sessions. RPM is the binding
# constraint on a free tier, so raise this only after the learned limits below
# have settled.
LINE_COUNT=1

# ---------------------------------------------------------------------------
# Learned rate limits (v2.9)
# ---------------------------------------------------------------------------
# Each provider's *_RPM constant is hand-typed and often wrong in the expensive
# direction: the reference build logged 217 genuine http_429s, 281 of 325
# cooldowns from groq alone. Backoff was never the problem -- the limit was.
# These have the governor learn the real limit from the provider's refusals.
RPM_SELF_TUNING=true
RPM_RATCHET_DOWN=0.7
RPM_LEARNED_FLOOR=4
RPM_RECOVER_AFTER_CLEAN=40

# Keep every role that judges Builder output off the Builder's weights. A
# reviewer sharing the builder's weights is an echo, not a check; free-tier
# routing otherwise sends both roles to the same flash model. When no
# independent model is available the exclusion is given up and
# `reviewer_independence_unavailable` is logged -- never silently.
#
# v2.9 widened this three ways, all of them fixing a rule that did less than it
# claimed:
#   * membership is the explicit set `agent_roles.AUDITING_ROLES`, not a
#     `reviewer` prefix -- the prefix silently excluded the v2.9 `spec_critic`
#     and `diagnosis`, which both judge Builder output;
#   * exclusion covers the Builder's model *family*, not just its exact ids,
#     because excluding one id leaves its renamed sibling in the pool;
#   * `reviewer_bugfix` and `diagnosis` were re-pointed off the Builder's
#     configured model, which mattered under FREE_MODEL_ROUTING=false.
#
# Measured: a Builder that used three families leaves 29 of 31 reviewer-capable
# models. A Builder on a premium model filters nothing, because no model of that
# family sits in the free roster -- correct, but worth knowing: the rule is
# inert until the Builder is actually routed free.
REVIEWER_MODEL_EXCLUSION=true
