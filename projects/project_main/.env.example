# project_main (trading system) -- environment reference
# Copy to .env inside this project directory. Keys are SEPARATE from the
# coding workspace root on purpose.
# This file (.env) is loaded automatically at startup (python-dotenv);
# real environment variables still take precedence. pytest skips the load.

# Alpaca PAPER trading keys (https://app.alpaca.markets -> Paper Trading)
# The broker client refuses live endpoints while PAPER_ONLY=true.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
PAPER_ONLY=true

# OpenRouter (agent LLM calls; z-ai/glm-5.3-flash default routing)
OPENROUTER_API_KEY=

# Comma-separated tickers. Default dev watchlist (10) is used when empty.
# Example expanded universe: mega-cap tech + sector ETFs (ETFs are exempt
# from the sector concentration cap).
# WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,SPY,QQQ,AMD,COST,AVGO,ADBE,CRM,NFLX,JPM,WMT,XLK,XLF,XLV,XLE,XLY,XLI,XLP,XLU,XLB,XLC,XLRE
WATCHLIST=

# Quant signal entry thresholds (src/quant/signals.py). Defaults match
# the original fixed rules; junk values fall back to them. MOMENTUM is
# the 10-day-MA slope in PERCENT per day (price-scale invariant), so
# high-priced names are not structurally blocked from BUYs.
Z_BUY_ENTRY=-1.5
Z_SELL_ENTRY=1.5
MOMENTUM_FLOOR_PCT=-0.5

# BUY-side confirmation gates (src/quant/signals.py). Each fails open:
# missing volume or regime data never blocks a BUY; SELLs are ungated.
# VOLUME_Z_MIN_BUY: BUY requires the bar's volume z-score >= threshold
#   (volume confirmation; leave unset to disable).
# FEAR_Z_MAX_BUY: BUY blocked when the regime fear_z composite exceeds
#   the threshold (needs the regime snapshot; unset disables).
# BREADTH_GOLD_EQ_MIN_BUY: BUY blocked when the gold/equity breadth
#   z-score falls below the threshold (extreme risk-off; unset disables).
# VOLUME_Z_MIN_BUY=0.0
# FEAR_Z_MAX_BUY=1.5
# BREADTH_GOLD_EQ_MIN_BUY=-1.0

# Per-run cost guard: max tickers analyzed in one invocation (100-ready)
MAX_TICKERS_PER_RUN=10

# SQLite decision audit log (hard rule 6). Written by scan/paper-run/smoke.
DECISIONS_DB=data/decisions.sqlite3

# Portfolio sizing (consumed by src.cli._components -> build_order_plan).
# ACCOUNT_EQUITY is a fallback only; paper-run uses live /v2/account equity.
# Budget per ticker = equity * MAX_POSITION_PCT, scaled DOWN by volatility
# (TARGET_DAILY_VOL / daily_vol, capped at 1.0 -- never scales up), by
# quant conviction (confidence / 0.95, floored at 0.25), by the debate
# winner (DEBATE_OPPOSE_MULT when the winner opposes the signal) and by
# an optional transaction-cost buffer. SELL orders are capped at held
# quantity (fetched live when keys are present).
ACCOUNT_EQUITY=100000
MAX_POSITION_PCT=0.10
TARGET_DAILY_VOL=0.02

# Debate-winner conviction: a bear winner shrinks BUYs, a bull winner
# shrinks SELLs, by this factor (clamped to [0.25, 1.0]; undecided no-op).
DEBATE_OPPOSE_MULT=0.75

# Transaction-cost awareness (opt-in buffer + dust filter).
# Effective dust floor = the SMALLER of MIN_TRADE_NOTIONAL (absolute)
# and max($1, equity * MIN_TRADE_NOTIONAL_PCT): accounts >= $1,000 keep
# the $10 absolute floor; smaller accounts scale down to Alpaca's $1
# fractional minimum so tiny budgets (and dust exits) still trade.
# An absolute floor ABOVE the default is an explicit stricter override
# (e.g. MIN_TRADE_NOTIONAL=1000000 as the pause-everything kill switch).
COST_BUFFER_PCT=0.0
MIN_TRADE_NOTIONAL=10
MIN_TRADE_NOTIONAL_PCT=0.01

# Execution cost model for backtests (spread + slippage; Alpaca has no commission).
# SPREAD_BPS: Bid-ask spread in basis points (1 bp = 0.01%). Default 10 for liquid names.
# SLIPPAGE_BPS: Market order slippage in basis points. Default 3.
# COST_SCALE_BY_VOL: If 1, scale costs by daily_vol relative to 2% baseline.
#                    Higher vol names get proportionally higher costs.
SPREAD_BPS=10.0
SLIPPAGE_BPS=3.0
COST_SCALE_BY_VOL=1

# Batch-level inverse-vol risk parity (item 8): same-day BUY candidates
# carrying a valid daily_vol get an equal-risk-contribution cap. Cap only
# -- low-vol names never exceed their factor budget. 0 disables.
INVOL_ENABLED=1

# Kelly sizing (item 7): `python -m src.cli backtest` writes replay stats
# to BACKTEST_STATS_PATH; when usable (n >= KELLY_MIN_TRADES, positive
# fraction) budgets scale by 1 + (KELLY_MAX_MULT - 1) *
# min(fraction / KELLY_FRACTION_CAP, 1). Kelly is the only scale-up
# factor and is hard-capped per name at equity * MAX_POSITION_PCT *
# KELLY_MAX_MULT. KELLY_ENABLED=0 ignores stats entirely.
KELLY_ENABLED=1
KELLY_FRACTION_CAP=0.25
KELLY_MAX_MULT=1.5
KELLY_MIN_TRADES=30
BACKTEST_STATS_PATH=data/backtest_stats.json
# Overnight replay stats (`python -m src.cli backtest --mode overnight`).
# Separate file on purpose: overnight experiments never feed intraday
# Kelly sizing; the overnight cycle reads the per_side BUY stats.
OVERNIGHT_STATS_PATH=data/backtest_stats_overnight.json

# Continuous modes (`session` / `overnight`).  Cross-cycle discipline:
# at most 1 BUY + 1 SELL per ticker per session day, no re-submission
# while an open order exists, session-wide BUY notional capped at equity.
SESSION_MAX_BUYS_PER_TICKER=1
SESSION_MAX_SELLS_PER_TICKER=1
# Overnight entry concentration cap (confidence-ranked approved BUYs).
OVERNIGHT_MAX_NAMES=5

# Sector concentration cap: max BUY notional per sector as a fraction of
# equity. Sector labels come from yfinance fundamentals; tickers without a
# sector (ETFs) are exempt.
MAX_SECTOR_PCT=0.30

# Correlation-cluster concentration cap (item 11): tickers whose aligned
# daily returns correlate at or above CORR_CLUSTER_THRESHOLD (positive
# correlations only; single-linkage chaining) form clusters; BUY notional
# per cluster is capped like a pseudo-sector. Needs CORR_MIN_OBSERVATIONS
# aligned returns -- fewer and clustering fails open (no clusters).
MAX_CORR_PCT=0.30
CORR_CLUSTER_THRESHOLD=0.80
CORR_MIN_OBSERVATIONS=60
CORR_CLUSTERING_ENABLED=1

# Global liquidity & fear regime (src/data/regime.py). Computed once per run
# from bonds (TLT, ^IRX, ^TNX), USD/JPY, DXY, GLD/SPY, copper/gold (CPER),
# credit (HYG/IEF), VIX term structure (^VIX/^VIX3M) and breadth (RSP, IWM).
# panic (VIX backwardation + VIX >= 30) blocks BUYs; risk_off scales the
# budget by REGIME_BUDGET_MULT (clamped to [0, 1] -- never scales up).
# Set REGIME_ENABLED=0 to skip the fetch (offline tests stay neutral).
# Gate thresholds are tunable (defaults shown); junk values fall back to
# them. Use `python -m src.cli regime-sweep` to compare fire rates before
# changing a threshold.
REGIME_BUDGET_MULT=0.5
REGIME_ENABLED=1
REGIME_CACHE_ROOT=data/cache
# Tuned 2026-09-08 from 1y/2y/5y regime sweeps (target: ~3-10% fire rate
# per gate, stable across periods).  VIX_BACKWARDATION kept at 1.0
# (5.1-8.9%); VIX_PANIC_LEVEL lowered 30->25 (0.8-2.7% was too rare);
# FEAR_Z raised 1.0->1.5 (17.5% at 1y was noise-heavy); LIQUIDITY_Z floor
# raised -1.0->-0.5 (-1.0 never fired in 2y/5y).
VIX_BACKWARDATION=1.0
VIX_PANIC_LEVEL=25
FEAR_Z_THRESHOLD=1.5
LIQUIDITY_Z_FLOOR=-0.5

# Comma-separated ISO dates of recent day trades (PDT gate); empty = none.
DAY_TRADE_DATES=

# ---- Whale/flow data sources (all optional; each fails open to a
#      "no data" sentinel when unset, and the pipeline stays neutral) ----

# SEC insider filings (Form 4/144) via edgartools -- NOT a key: the SEC
# requires programmatic EDGAR access to declare an identity. Put your real
# name and email, e.g. "Jane Doe jane.doe@example.com". Free, instant.
EDGAR_IDENTITY=

# FINRA dark-pool ATS/TRF proxy (weekly ATS volume data).
# Get a free registered API key: create an account on the FINRA API
# developer portal (https://api.finra.org), register an app, and copy the
# API key. It grants the otcMarket data-group datasets used by
# src/data/dark_pool.py. Without it the fetcher returns no data (fail-open).
FINRA_API_KEY=

# Institutional 13F holder data (whale alerts, exodus veto input).
# Sign up with the unified institutional-data vendor of your choice on the
# free tier and paste the key. The endpoint/field mapping in
# src/data/institutional.py is defensive and documented for the assumed
# schema; override the endpoint with SECURITIESDB_BASE_URL if your vendor
# differs, and verify with a smoke script before trusting live numbers.
# Without a key the fetcher returns no data (fail-open).
SECURITIESDB_API_KEY=

# Feature flags (0 disables the fetcher; the pipeline behaves exactly as
# before -- no new fetcher runs and no new analyst is dispatched).
INSIDER_ENABLED=1
INSTITUTIONAL_ENABLED=1
OPTIONS_FLOW_ENABLED=1
DARK_POOL_ENABLED=1

# Options-flow scan bounds + whale/flow risk-veto thresholds.
UOA_MIN_VOL_OI_RATIO=3.0
UOA_MIN_PREMIUM=25000
UOA_MAX_DTE=45
INSIDER_LOOKBACK_DAYS=90
CLUSTER_INSIDER_THRESHOLD=3
FLOW_VETO_MIN_HOLDERS=10
UOA_PUT_SKEW_VETO=0.30

# ---- Pairs trading (stat-arb module) ----
# Long-only conditioned mean reversion on cointegrated S&P 400 pairs.
# Off by default in the pipeline; scan/paper-run opt in via --with-pairs.
# Requires statsmodels (ADF) + lxml (Wikipedia universe scrape).
PAIRS_ENABLED=1
UNIVERSE_SOURCE=sp400
UNIVERSE_MIN_ADV=1000000
UNIVERSE_MIN_MCAP=2000000000
UNIVERSE_MAX_MCAP=10000000000
UNIVERSE_REFRESH_DAYS=7
UNIVERSE_FALLBACK_PATH=data/universe_sp400_fallback.txt
COINT_LOOKBACK_DAYS=252
COINT_ADF_PVALUE=0.05
COINT_MIN_HALF_LIFE=5
COINT_MAX_HALF_LIFE=60
COINT_MAX_LAG=1
PAIR_PRESCREEN_CORR=0.70
PAIR_PRICE_PERIOD=2y
MAX_PAIRS=10
MAX_PAIRS_PER_SECTOR=3
MIN_PAIR_SHARPE=1.0
PAIR_REBALANCE_DAYS=21
PAIR_Z_ENTRY=2.0
PAIR_Z_EXIT=0.5
PAIR_Z_STOP=3.5
# Per-pair cap counts BOTH legs combined (2 x 1.5%); 10 pairs x 3% = 30%.
MAX_PAIR_PCT=0.03
MAX_PAIRS_PCT=0.30
PAIR_BOOK_PATH=data/pairs_active.json
# Pairs Kelly is a SEPARATE stats file (pairs-backtest output) with its
# own caps -- isolated from intraday/overnight Kelly like the overnight
# file. The 0.5 cap is a ceiling pending walk-forward validation
# (Phase 4 ship gate: aggregate Sharpe > 1, else keep the mult at 1.0).
PAIR_KELLY_ENABLED=1
PAIR_KELLY_FRACTION_CAP=0.5
PAIR_KELLY_MAX_MULT=1.5
PAIR_BACKTEST_STATS_PATH=data/pairs_backtest_stats.json
